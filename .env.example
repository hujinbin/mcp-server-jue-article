# MCP服务器配置
MCP_SERVER_NAME=jue-knowledge-base
MCP_SERVER_VERSION=1.0.0

# 下列三个变量仅用于本地/服务器常驻进程；Vercel 无需配置且不会启动监听
MCP_TRANSPORT=http
MCP_HOST=127.0.0.1
MCP_PORT=3101
# Vercel 在项目 Settings → Environment Variables 中配置，不要上传本地 .env
MCP_AUTH_TOKEN=replace-with-a-long-random-token
JUE_API_BASE_URL=https://jue.leheavengame.com/api
JUE_SITE_URL=https://jue.leheavengame.com
# 允许插件所在网站的来源，多个来源使用逗号分隔
# 填写实际网站来源，不是 MCP 服务域名；必须包含 https://，不要带路径或末尾斜杠
MCP_ALLOWED_ORIGINS=https://jue.leheavengame.com,https://www.leheavengame.com

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/mcp", "destination": "/api/mcp" },
    { "source": "/mcp/", "destination": "/api/mcp" },
    { "source": "/health", "destination": "/api/health" },
    { "source": "/health/", "destination": "/api/health" },
    { "source": "/", "destination": "/api/health" }
  ]
}
